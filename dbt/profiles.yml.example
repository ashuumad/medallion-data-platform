# ============================================================
# ~/.dbt/profiles.yml — Enterprise multi-environment config
# ============================================================
# Copy this to ~/.dbt/profiles.yml (NOT inside your repo)
#
# Targets match Terraform workspaces:
#   dbt run --target dev   → uses DEV storage
#   dbt run --target qa    → uses QA storage
#   dbt run --target prod  → uses PROD storage
# ============================================================

medallion:
  target: dev   # default target when none specified

  outputs:

    # ── LOCAL DEVELOPMENT (no Azure needed) ──────────────────
    dev:
      type: duckdb
      path: '../data/medallion_dev.duckdb'
      threads: 4
      schema: main    # dbt will prefix: bronze_dev, silver_dev, gold_dev

    # ── QA ENVIRONMENT (Azure) ───────────────────────────────
    qa:
      type: duckdb
      path: 'abfss://medallion@stmedalnqa.dfs.core.windows.net/dbt.duckdb'
      threads: 4
      schema: main

    # ── PRODUCTION ENVIRONMENT (Azure) ───────────────────────
    prod:
      type: duckdb
      path: 'abfss://medallion@stmedalnprod.dfs.core.windows.net/dbt.duckdb'
      threads: 8      # more threads in prod for performance
      schema: main
